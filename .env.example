# Copy to .env.local and fill in. NEVER commit .env.local.
# Every value below except NEXT_PUBLIC_SITE_URL is server-side only and must
# never be prefixed NEXT_PUBLIC_ or referenced from a client component.

# Public site URL — canonical URLs, sitemap, and Origin validation.
# Safe to expose; this is the only browser-visible variable.
NEXT_PUBLIC_SITE_URL=

# Resend — transactional email for contact/audit form submissions.
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "WPInstallations <audits@wpinstallations.com>"
RESEND_FROM=
# Internal address that receives new lead notifications.
LEAD_NOTIFICATION_EMAIL=

# Upstash Redis — shared-store rate limiting for the form endpoint.
# In-memory counters do not survive across Vercel serverless instances.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
